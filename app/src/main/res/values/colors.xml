<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- hsl(0, 5%, 6%): the same formula Md3SchemeBuilder uses for the md
         background token, evaluated at the default hue so the splash screen
         never flashes a mismatched color. -->
    <color name="splash_background">#FF000000</color>

    <!-- SpotiAisexs app icon ("Ecualizador", Oct 2026): near-black tile behind
         the five tangerine bars. Used as the adaptive icon's background layer,
         paired with ic_launcher_foreground for the bars. -->
    <color name="ic_launcher_background">#FF141414</color>

    <!-- Android Auto: the default accent of the design ("Cristal, color de
         portada": hsl(16, 90%, 76%) from #FF7A45) and its dark ink. -->
    <color name="auto_accent">#FFFF7A1A</color>
    <color name="auto_accent_ink">#FF1A0A00</color>
</resources>
