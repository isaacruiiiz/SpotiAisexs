+++ b/web/styles.css
@@ -0,0 +1,128 @@
+/* SpotiAisexs web — Apple (glass chrome, large titles) + Spotify (black, artwork-led). */
+:root {
+  --bg: #000000;
+  --s1: #121212;
+  --s2: #1c1c1c;
+  --s3: #292929;
+  --text: #f5f5f7;
+  --muted: #a1a1a1;
+  --accent: #ff7a45;
+  --on-accent: #1a0e08;
+  --glass: rgba(40, 40, 40, 0.62);
+  --hairline: rgba(255, 255, 255, 0.12);
+  --radius: 16px;
+}
+* { box-sizing: border-box; }
+html, body { margin: 0; height: 100%; background: var(--bg); color: var(--text); }
+body {
+  font-family: "Figtree", "Helvetica Neue", Arial, sans-serif;
+  -webkit-font-smoothing: antialiased;
+  padding-top: env(safe-area-inset-top, 0px);
+  padding-bottom: env(safe-area-inset-bottom, 0px);
+}
+[hidden] { display: none !important; }
+button { font-family: inherit; color: inherit; cursor: pointer; }
+.muted { color: var(--muted); }
+code { background: var(--s2); padding: 2px 6px; border-radius: 6px; }
+
+/* Login / setup */
+.login { min-height: 100vh; display: grid; place-items: center; padding: 24px; }
+.login-card {
+  width: min(380px, 100%); display: flex; flex-direction: column; gap: 14px;
+  background: var(--s1); border: 1px solid var(--hairline); border-radius: 24px; padding: 32px;
+}
+.login-logo { border-radius: 16px; align-self: center; }
+.login-card h1 { margin: 0; text-align: center; font-size: 28px; font-weight: 800; letter-spacing: -0.6px; }
+.login-card p { margin: 0; text-align: center; font-size: 14px; line-height: 20px; }
+.login-card label { display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; color: var(--muted); }
+.login-card input {
+  height: 46px; border-radius: 12px; border: 1px solid var(--hairline); background: var(--s2);
+  color: var(--text); padding: 0 14px; font: inherit; font-size: 15px;
+}
+.login-card input:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
+.btn-primary {
+  height: 48px; border: 0; border-radius: 24px; background: var(--accent); color: var(--on-accent);
+  font-size: 15px; font-weight: 800; margin-top: 6px;
+}
+.btn-primary:hover { filter: brightness(1.08); }
+.error { color: #ff6b6b; min-height: 20px; }
+
+/* Top bar (glass, Apple navigation layer) */
+.topbar {
+  position: sticky; top: 0; z-index: 5; height: 64px; padding: 0 24px;
+  display: flex; align-items: center; justify-content: space-between;
+  background: rgba(0, 0, 0, 0.6); backdrop-filter: blur(24px) saturate(170%); -webkit-backdrop-filter: blur(24px) saturate(170%);
+  border-bottom: 1px solid var(--hairline);
+}
+.brand { display: flex; align-items: center; gap: 10px; font-weight: 800; font-size: 18px; letter-spacing: -0.3px; }
+.brand img { border-radius: 8px; }
+.topbar-right { display: flex; align-items: center; gap: 14px; }
+.sync-dot { width: 10px; height: 10px; border-radius: 5px; background: var(--s3); }
+.sync-dot.on { background: var(--accent); box-shadow: 0 0 0 4px rgba(255, 122, 69, 0.18); }
+.btn-ghost { height: 36px; padding: 0 16px; border-radius: 18px; border: 1px solid var(--hairline); background: transparent; font-weight: 700; font-size: 13px; }
+.btn-ghost:hover { background: var(--s2); }
+
+/* Layout */
+.layout {
+  display: grid; grid-template-columns: minmax(0, 1fr) 360px; gap: 32px;
+  max-width: 1120px; margin: 0 auto; padding: 32px 24px 48px;
+}
+@media (max-width: 860px) { .layout { grid-template-columns: minmax(0, 1fr); gap: 24px; padding: 20px 16px 40px; } }
+
+.now { display: flex; flex-direction: column; align-items: center; gap: 22px; }
+.cover-wrap { position: relative; width: min(420px, 100%); aspect-ratio: 1 / 1; }
+.cover {
+  position: absolute; inset: 0; width: 100%; height: 100%; border-radius: var(--radius);
+  object-fit: cover; background: var(--s2); box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
+}
+.cover-empty { display: grid; place-items: center; }
+.cover-empty svg { fill: var(--accent); }
+.yt-holder { overflow: hidden; background: #000; }
+.yt-holder iframe, .yt-holder #yt-player { width: 100%; height: 100%; border: 0; }
+
+.meta { width: min(420px, 100%); }
+.titles h1 { margin: 0; font-size: 28px; line-height: 34px; font-weight: 800; letter-spacing: -0.6px; }
+.titles p { margin: 2px 0 0; font-size: 17px; line-height: 22px; font-weight: 500; }
+
+.progress { width: min(420px, 100%); display: flex; flex-direction: column; gap: 8px; }
+.bar { position: relative; height: 6px; border-radius: 3px; background: var(--s3); cursor: pointer; }
+.bar-fill { height: 100%; width: 0; border-radius: 3px; background: var(--text); }
+.bar-knob { position: absolute; top: 50%; left: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 7px; background: var(--text); opacity: 0; transition: opacity .15s; }
+.bar:hover .bar-knob, .bar:focus .bar-knob { opacity: 1; }
+.bar:hover .bar-fill { background: var(--accent); }
+.times { display: flex; justify-content: space-between; font-size: 12px; color: var(--muted); font-variant-numeric: tabular-nums; }
+
+.controls { display: flex; align-items: center; gap: 28px; }
+.btn-icon { width: 52px; height: 52px; border: 0; border-radius: 26px; background: transparent; display: grid; place-items: center; }
+.btn-icon:hover { background: var(--s2); }
+.btn-play { width: 72px; height: 72px; border: 0; border-radius: 36px; background: var(--text); color: #000; display: grid; place-items: center; }
+.btn-play:hover { transform: scale(1.04); }
+
+.devices { position: relative; }
+.device-btn {
+  display: flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px; border-radius: 19px;
+  border: 1px solid var(--hairline); background: var(--glass); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
+  font-size: 13px; font-weight: 700;
+}
+.device-btn.remote { color: var(--accent); border-color: rgba(255, 122, 69, 0.4); }
+.device-menu {
+  position: absolute; bottom: 46px; left: 50%; transform: translateX(-50%); min-width: 280px; z-index: 10;
+  background: rgba(28, 28, 28, 0.86); backdrop-filter: blur(28px) saturate(170%); -webkit-backdrop-filter: blur(28px) saturate(170%);
+  border: 1px solid var(--hairline); border-radius: 18px; padding: 8px; display: flex; flex-direction: column; gap: 2px;
+}
+.device-menu h3 { margin: 6px 10px 6px; font-size: 13px; color: var(--muted); font-weight: 700; }
+.device-item { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; border: 0; background: transparent; text-align: left; font-size: 14px; font-weight: 600; }
+.device-item:hover { background: var(--s3); }
+.device-item.active { color: var(--accent); }
+.device-item small { display: block; color: var(--muted); font-weight: 500; font-size: 12px; }
+
+.queue { background: var(--s1); border-radius: 20px; padding: 20px; align-self: start; }
+.queue h2 { margin: 0 0 12px; font-size: 20px; font-weight: 800; letter-spacing: -0.4px; }
+.queue-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; max-height: 70vh; overflow-y: auto; }
+.queue-item { display: flex; align-items: center; gap: 12px; padding: 8px; border-radius: 10px; cursor: pointer; }
+.queue-item:hover { background: var(--s2); }
+.queue-item.current .q-title { color: var(--accent); }
+.queue-item img, .q-thumb { width: 44px; height: 44px; border-radius: 6px; object-fit: cover; background: var(--s3); flex-shrink: 0; }
+.q-text { min-width: 0; }
+.q-title { font-size: 14px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.q-artist { font-size: 12px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
